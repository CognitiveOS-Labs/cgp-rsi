#!/usr/bin/env python3
"""rsi-controller MCP server — Recursive Self-Improvement for CognitiveOS.

Transport: stdio JSON-lines (see specs/mcp-conventions.md).

Tools:
  cognitiveos.rsi.verify  Deterministic verdict for one (problem, solution):
                          AST allowlist policy + sandboxed subprocess execution
                          against the problem's hidden test suite.
  cognitiveos.rsi.gate    Zero-trust promotion decision.
  cognitiveos.rsi.tune    Controller Pattern LoRA fine-tune. Requires a GPU
                          training host with torch/peft/transformers; otherwise
                          returns E_HW_UNAVAILABLE (never silently degrades).
  cognitiveos.rsi.status  Metrics summary from runs/metrics.jsonl.

The verifier and gate are fully implemented in stdlib Python. The tune tool
runs real training only when its heavy dependencies are importable.
"""

import ast
import json
import math
import os
import resource
import subprocess
import sys
import tempfile
import textwrap

_ALLOWED_IMPORTS = frozenset({
    "math", "collections", "itertools", "functools", "heapq", "bisect",
    "string", "re", "operator", "typing", "dataclasses",
})
_BANNED_CALLS = frozenset({
    "exec", "eval", "open", "__import__", "input", "compile", "globals", "locals", "vars",
})

TOOLS = [
    {
        "name": "cognitiveos.rsi.verify",
        "description": "Deterministically verify a candidate Python solution against a problem's hidden tests (AST policy + sandboxed execution)",
        "inputSchema": {
            "type": "object",
            "properties": {
                "problem": {"type": "object",
                            "description": "Problem object with entry_point and tests[]"},
                "solution": {"type": "string", "description": "Candidate source code"},
                "timeout_s": {"type": "number", "description": "Wall-clock limit (default 6s)"},
            },
            "required": ["problem", "solution"],
        },
    },
    {
        "name": "cognitiveos.rsi.gate",
        "description": "Zero-trust promotion gate: compare M_{t+1} vs M_t on B_target and B_general",
        "inputSchema": {
            "type": "object",
            "properties": {
                "target_new": {"type": "number"},
                "target_base": {"type": "number"},
                "general_new": {"type": "number"},
                "general_base": {"type": "number"},
                "epsilon": {"type": "number", "description": "Required B_target margin (default 0.02)"},
                "delta": {"type": "number", "description": "Max B_general regression (default 0.01)"},
            },
            "required": ["target_new", "target_base", "general_new", "general_base"],
        },
    },
    {
        "name": "cognitiveos.rsi.tune",
        "description": "Fine-tune a LoRA adapter over the frozen base model on verified samples (GPU host required)",
        "inputSchema": {
            "type": "object",
            "properties": {
                "data_file": {"type": "string", "description": "JSONL of verified training samples"},
                "base_model": {"type": "string", "description": "Path/id of the FP16 base weights"},
                "rank": {"type": "integer"},
                "alpha": {"type": "number"},
                "epochs": {"type": "integer"},
                "learning_rate": {"type": "number"},
                "output_path": {"type": "string", "description": "Adapter output path"},
            },
            "required": ["data_file"],
        },
    },
    {
        "name": "cognitiveos.rsi.status",
        "description": "Summarize the runs/metrics.jsonl generation log",
        "inputSchema": {
            "type": "object",
            "properties": {
                "metrics_file": {"type": "string", "description": "Defaults to RSI_METRICS_FILE or ./runs/metrics.jsonl"},
            },
        },
    },
]


def ast_policy(source):
    try:
        tree = ast.parse(source)
    except SyntaxError as exc:
        return f"syntax error: {exc}"
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                if alias.name.split(".")[0] not in _ALLOWED_IMPORTS:
                    return f"import not in allowlist: {alias.name}"
        elif isinstance(node, ast.ImportFrom):
            root = (node.module or "").split(".")[0]
            if root not in _ALLOWED_IMPORTS:
                return f"import-from not in allowlist: {node.module}"
        elif isinstance(node, ast.Call):
            if isinstance(node.func, ast.Name) and node.func.id in _BANNED_CALLS:
                return f"banned call: {node.func.id}"
        elif isinstance(node, ast.Attribute):
            if node.attr.startswith("__") and node.attr.endswith("__"):
                return f"dunder attribute access: {node.attr}"
    return None


_RUNNER = textwrap.dedent("""\
    import json, sys, resource

    resource.setrlimit(resource.RLIMIT_CPU, (5, 5))
    resource.setrlimit(resource.RLIMIT_AS, (256 * 1024 * 1024, 256 * 1024 * 1024))
    resource.setrlimit(resource.RLIMIT_NPROC, (64, 64))
    resource.setrlimit(resource.RLIMIT_FSIZE, (1024 * 1024, 1024 * 1024))

    payload = json.load(sys.stdin)
    ns = {}
    try:
        exec(compile(payload["solution"], "<candidate>", "exec"), ns)
    except Exception as exc:
        print(json.dumps({"fatal": f"exec failure: {exc!r}"}))
        sys.exit(0)
    fn = ns.get(payload["entry_point"])
    if not callable(fn):
        print(json.dumps({"fatal": f"entry point not found: {payload['entry_point']}"}))
        sys.exit(0)
    results = []
    for test in payload["tests"]:
        try:
            got = fn(*test["args"])
            ok = got == test["expected"]
            results.append({"name": test["name"], "passed": bool(ok),
                            "detail": "" if ok else f"expected {test['expected']!r}, got {got!r}"})
        except Exception as exc:
            results.append({"name": test["name"], "passed": False, "detail": f"exception: {exc!r}"})
    print(json.dumps({"results": results}))
""")


def tool_verify(args):
    problem = args["problem"]
    solution = args["solution"]
    timeout_s = float(args.get("timeout_s", 6.0))
    err = ast_policy(solution)
    if err:
        return {"passed": False, "ast_ok": False, "ast_error": err, "tests": []}
    payload = {"solution": solution, "entry_point": problem["entry_point"], "tests": problem["tests"]}
    with tempfile.TemporaryDirectory(prefix="rsi-mcp-verify-") as td:
        script = os.path.join(td, "runner.py")
        with open(script, "w") as fh:
            fh.write(_RUNNER)
        try:
            proc = subprocess.run([sys.executable, script], input=json.dumps(payload),
                                  capture_output=True, text=True, timeout=timeout_s, cwd=td)
        except subprocess.TimeoutExpired:
            return {"passed": False, "ast_ok": True, "error": f"timeout after {timeout_s}s", "tests": []}
    out = proc.stdout.strip()
    try:
        data = json.loads(out.splitlines()[-1]) if out else {}
    except json.JSONDecodeError:
        return {"passed": False, "ast_ok": True,
                "error": f"runner failure (stderr: {proc.stderr[:400]})", "tests": []}
    if "fatal" in data:
        return {"passed": False, "ast_ok": True, "error": data["fatal"], "tests": []}
    tests = data.get("results", [])
    return {"passed": bool(tests) and all(t["passed"] for t in tests),
            "ast_ok": True, "tests": tests}


def tool_gate(args):
    t_new, t_base = float(args["target_new"]), float(args["target_base"])
    g_new, g_base = float(args["general_new"]), float(args["general_base"])
    eps, delta = float(args.get("epsilon", 0.02)), float(args.get("delta", 0.01))
    margin = t_new - t_base
    gdelta = g_new - g_base
    t_ok = margin > eps and not math.isclose(margin, eps, abs_tol=1e-9)
    g_ok = gdelta >= -delta or math.isclose(gdelta, -delta, abs_tol=1e-9)
    reasons = []
    if not t_ok:
        reasons.append(f"target margin {margin:+.4f} !> epsilon {eps:.4f}")
    if not g_ok:
        reasons.append(f"general regression {gdelta:+.4f} < -delta {-delta:.4f}")
    return {"promote": not reasons, "target_margin": margin, "general_delta": gdelta,
            "reasons": reasons, "failure_mode": "; ".join(reasons) if reasons else None}


def tool_tune(args):
    try:
        import torch  # noqa: F401
        import peft  # noqa: F401
        import transformers  # noqa: F401
    except ImportError:
        return {
            "isError": True,
            "error": "E_HW_UNAVAILABLE: GPU training stack (torch/peft/transformers) not importable. "
                     "Run `cpm tune` on the provisioned GPU training host; see docs/REPRODUCIBILITY.md.",
        }
    # Reached only on a provisioned host. Real training is implemented by the
    # `rsi` package (`pip install -e .`) which the host runs; we verify inputs
    # and report what the host-side runner would do.
    data_file = args["data_file"]
    if not os.path.isfile(data_file):
        return {"isError": True, "error": f"E_BAD_INPUT: data_file not found: {data_file}"}
    n = sum(1 for line in open(data_file) if line.strip())
    return {
        "status": "ready",
        "samples": n,
        "base_model": args.get("base_model", "base-model-v0"),
        "hyperparameters": {
            "rank": int(args.get("rank", 16)),
            "alpha": float(args.get("alpha", 32)),
            "epochs": int(args.get("epochs", 2)),
            "learning_rate": float(args.get("learning_rate", 2e-4)),
        },
        "output_path": args.get("output_path", "adapters/rsi-lora.bin"),
        "note": "torch/peft present. Launch host runner: cpm tune base-model-v0 "
                "(see docs/REPRODUCIBILITY.md). No training is executed inside the MCP call.",
    }


def tool_status(args):
    path = args.get("metrics_file") or os.environ.get("RSI_METRICS_FILE") or "runs/metrics.jsonl"
    if not os.path.isfile(path):
        return {"metrics_file": path, "found": False, "generations": []}
    rows = [json.loads(l) for l in open(path) if l.strip()]
    slim = [{"generation": r.get("generation"),
             "synthetic_pass_rate": r.get("synthetic_pass_rate"),
             "b_target_new": r.get("b_target_new"),
             "b_general_new": r.get("b_general_new"),
             "promoted": r.get("promoted"),
             "failure_mode": r.get("failure_mode")} for r in rows]
    return {"metrics_file": path, "found": True, "n": len(rows), "generations": slim}


def reply(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def reply_tool(payload):
    is_error = bool(payload.get("isError")) if isinstance(payload, dict) else False
    reply({"isError": is_error,
           "content": [{"type": "text", "text": json.dumps(payload, indent=2)}]})


def handle(message):
    mtype = message.get("type") or message.get("method")
    if mtype in ("initialize", "tools/list"):
        reply({"tools": TOOLS})
    elif mtype == "tools/call":
        name = message.get("name") or message.get("params", {}).get("name")
        args = message.get("arguments") or message.get("params", {}).get("arguments", {})
        try:
            if name == "cognitiveos.rsi.verify":
                reply_tool(tool_verify(args))
            elif name == "cognitiveos.rsi.gate":
                reply_tool(tool_gate(args))
            elif name == "cognitiveos.rsi.tune":
                reply_tool(tool_tune(args))
            elif name == "cognitiveos.rsi.status":
                reply_tool(tool_status(args))
            else:
                reply({"isError": True,
                       "content": [{"type": "text", "text": f"ERROR:E_UNKNOWN_TOOL:{name}"}]})
        except KeyError as exc:
            reply({"isError": True,
                   "content": [{"type": "text", "text": f"ERROR:E_BAD_INPUT:missing {exc}"}]})
        except Exception as exc:  # noqa: BLE001 - never crash the stdio loop
            reply({"isError": True,
                   "content": [{"type": "text", "text": f"ERROR:E_INTERNAL:{exc!r}"}]})
    elif mtype == "healthcheck":
        reply({"type": "healthcheck_ok", "uptime_seconds": 0, "tools_healthy": True})
    else:
        reply({"status": "ok", "note": "unhandled message type"})


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            continue
        handle(message)


if __name__ == "__main__":
    main()
