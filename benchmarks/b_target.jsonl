{"id": "bt-001", "kind": "code", "entry_point": "fib", "prompt": "Return the n-th Fibonacci number with fib(0)=0 and fib(1)=1.", "tests": [{"name": "t0", "args": [0], "expected": 0}, {"name": "t1", "args": [1], "expected": 1}, {"name": "t7", "args": [7], "expected": 13}, {"name": "t10", "args": [10], "expected": 55}, {"name": "t15", "args": [15], "expected": 610}]}
{"id": "bt-002", "kind": "code", "entry_point": "count_vowels", "prompt": "Count the vowels (a, e, i, o, u, case-insensitive) in the string.", "tests": [{"name": "t1", "args": ["aeiou"], "expected": 5}, {"name": "t2", "args": ["xyz"], "expected": 0}, {"name": "t3", "args": ["Hello World"], "expected": 3}, {"name": "t4", "args": [""], "expected": 0}]}
{"id": "bt-003", "kind": "code", "entry_point": "second_largest", "prompt": "Return the second-largest DISTINCT value in the list. The list has at least two distinct values.", "tests": [{"name": "t1", "args": [[1, 9, 3]], "expected": 3}, {"name": "t2", "args": [[5, 5, 4]], "expected": 4}, {"name": "t3", "args": [[10, 2, 7]], "expected": 7}, {"name": "t4", "args": [[-1, -5, -3]], "expected": -3}]}
{"id": "bt-004", "kind": "code", "entry_point": "gcd", "prompt": "Return the greatest common divisor of two positive integers a and b.", "tests": [{"name": "t1", "args": [12, 18], "expected": 6}, {"name": "t2", "args": [17, 5], "expected": 1}, {"name": "t3", "args": [100, 25], "expected": 25}, {"name": "t4", "args": [7, 7], "expected": 7}]}
{"id": "bt-005", "kind": "code", "entry_point": "roman_to_int", "prompt": "Convert a Roman numeral string to an integer.", "tests": [{"name": "t1", "args": ["III"], "expected": 3}, {"name": "t2", "args": ["IV"], "expected": 4}, {"name": "t3", "args": ["IX"], "expected": 9}, {"name": "t4", "args": ["LVIII"], "expected": 58}, {"name": "t5", "args": ["MCMXCIV"], "expected": 1994}]}
{"id": "bt-006", "kind": "code", "entry_point": "longest_run", "prompt": "Return the length of the longest run of identical characters in the string. Empty string returns 0.", "tests": [{"name": "t1", "args": ["aaabbbbcddd"], "expected": 4}, {"name": "t2", "args": [""], "expected": 0}, {"name": "t3", "args": ["abc"], "expected": 1}, {"name": "t4", "args": ["aaaa"], "expected": 4}]}
{"id": "bt-007", "kind": "code", "entry_point": "is_palindrome_clean", "prompt": "Return True if the string is a palindrome after removing non-alphanumeric characters and lowercasing.", "tests": [{"name": "t1", "args": ["A man, a plan, a canal: Panama"], "expected": true}, {"name": "t2", "args": ["race a car"], "expected": false}, {"name": "t3", "args": [" "], "expected": true}, {"name": "t4", "args": ["No lemon, no melon"], "expected": true}]}
{"id": "bt-008", "kind": "code", "entry_point": "sum_of_squares_evens", "prompt": "Return the sum of the squares of the even numbers in the list.", "tests": [{"name": "t1", "args": [[1, 2, 3, 4]], "expected": 20}, {"name": "t2", "args": [[]], "expected": 0}, {"name": "t3", "args": [[2, 2]], "expected": 8}, {"name": "t4", "args": [[1, 3, 5]], "expected": 0}]}
